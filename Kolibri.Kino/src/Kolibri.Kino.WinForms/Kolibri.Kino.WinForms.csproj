<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Kolibri.Kino.Controllers\Kolibri.Kino.Controllers.csproj" />
    <ProjectReference Include="..\Kolibri.Kino.Data\Kolibri.Kino.Data.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.12" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- The .exe icon (Explorer, taskbar, shortcuts). Built from assets/kino.svg by assets/make-icon.cs. -->
    <ApplicationIcon>..\..\assets\kino.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- The same icon for every window's title bar (see Controls/AppIcon.cs). -->
    <EmbeddedResource Include="..\..\assets\kino.ico" LogicalName="Kolibri.Kino.WinForms.kino.ico" />
  </ItemGroup>

</Project>