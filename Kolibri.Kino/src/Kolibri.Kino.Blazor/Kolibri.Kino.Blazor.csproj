<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\Kolibri.Kino.Controllers\Kolibri.Kino.Controllers.csproj" />
    <ProjectReference Include="..\Kolibri.Kino.Data\Kolibri.Kino.Data.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <!-- The SDK only restores blazor.web.js when it sees .razor files, and the Dockerfile restores from the
         project files alone. Without this the container serves a blank page (404 on _framework/blazor.web.js). -->
    <RequiresAspNetWebAssets>true</RequiresAspNetWebAssets>
  </PropertyGroup>

</Project>
