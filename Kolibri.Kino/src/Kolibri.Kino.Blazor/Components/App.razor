<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <title>Kolibri Kino</title>
    <link rel="icon" type="image/svg+xml" href="kino.svg" />
    <ResourcePreloader />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["Kolibri.Kino.Blazor.styles.css"]" />
    <ImportMap />
    <HeadOutlet @rendermode="Interactive" />
</head>

<body>
    <Routes @rendermode="Interactive" />
    <ReconnectModal />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>

@code {
    // No prerendering: it would run every page's first load twice, and OMDb searches count against the daily limit.
    private static readonly IComponentRenderMode Interactive = new InteractiveServerRenderMode(prerender: false);
}
