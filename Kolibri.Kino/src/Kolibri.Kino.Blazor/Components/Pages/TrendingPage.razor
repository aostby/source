@page "/trending"
@using Kolibri.Kino.Controllers.Trending
@inherits KinoPage
@inject TrendingController Trending
@inject NavigationManager Nav

@* What's trending on TMDb this week: movies, TV shows or people (the list is in the address, so Back returns here).
   Titles open their details; a person opens the Library filtered by them, as an actor's name on a details page
   does. Lists are kept in the database for a few hours; images go in the image cache like posters. *@

<PageTitle>Trending · Kolibri Kino</PageTitle>

<h1>Trending</h1>

<div class="toolbar">
    <div class="chips" role="group" aria-label="List">
        @foreach (var (key, kind, label) in Lists)
        {
            <button class="chip @(kind == Kind ? "on" : "")" @onclick="() => Nav.NavigateTo(Nav.GetUriWithQueryParameter(KindParameter, key))">@label</button>
        }
    </div>
    <button class="sort" disabled="@Busy" title="Ask TMDb again now" @onclick="() => LoadAsync(refresh: true)">Refresh</button>
</div>

<StatusLine Busy="Busy" Text="@(Status ?? Summary)" Error="@Error" />

@if (_result is { } result)
{
    <div class="cards">
        @foreach (var entry in result.Entries)
        {
            var item = entry.Item;
            var image = $"trending/image/{result.Kind}/{item.TmdbId}";
            @if (result.Kind == TrendingKind.People)
            {
                <article class="card trending-card">
                    <a href="@PersonLink(item.Title)" class="card-link" title="@item.Title in the library">
                        <PosterImage Src="@(item.ImageUrl is null ? null : image)" />
                        <div class="card-body">
                            <h2 class="card-title">@item.Title</h2>
                            @if (entry.LibraryTitles > 0)
                            {
                                <span class="tag good">@entry.LibraryTitles in SilverScreen</span>
                            }
                            @if (item.KnownFor.Count > 0)
                            {
                                <p class="card-overview">Known for @string.Join(", ", item.KnownFor)</p>
                            }
                        </div>
                    </a>
                </article>
            }
            else
            {
                <TitleCard Entry="entry" Series="@(result.Kind == TrendingKind.Series)" Image="@image" />
            }
        }
    </div>
}

@code {
    private const string KindParameter = "list";

    private static readonly (string Key, TrendingKind Kind, string Label)[] Lists =
        [("movies", TrendingKind.Movies, "Movies"), ("tv", TrendingKind.Series, "TV shows"), ("people", TrendingKind.People, "People")];

    [SupplyParameterFromQuery(Name = KindParameter)] public string? List { get; set; }

    private TrendingResult? _result;

    private TrendingKind Kind => Lists.FirstOrDefault(l => l.Key == List).Kind; // Movies when not set

    private string? Summary => _result is not { } r ? null
        : r.Note ?? $"{TrendingController.Label(r.Kind)} on TMDb this week: {r.Entries.Count}"
          + (r.Kind == TrendingKind.People ? "" : $", {r.Entries.Count(e => e.HasFile)} in SilverScreen")
          + (r.FetchedUtc is { } at ? $". Updated {at.ToLocalTime():g}." : ".");

    protected override Task OnParametersSetAsync() => LoadAsync(refresh: false);

    private Task LoadAsync(bool refresh) => RunAsync("Asking TMDb what's trending…", async ct =>
    {
        _result = null;
        _result = await Trending.GetAsync(Kind, refresh, ct);
    });

    /// <summary>The Library filtered by the person, best rated first: what an actor's name on a details page opens.</summary>
    private static string PersonLink(string name) => $"./?person={Uri.EscapeDataString(name)}&sort=rating";
}
