@page "/"
@using System.Globalization
@using Kolibri.Kino.Controllers.Library
@inherits KinoPage
@inject MovieController Movies
@inject WatchlistController Watchlists
@inject LastSearch LastSearch
@inject Kolibri.Kino.Controllers.Ratings.RatingController Ratings
@inject NavigationManager Nav

@* Port of KinoForm: search the library or OMDb, filter by type, genre, year, rating, watched and person, sort, import.
   Watched = played to the end on Plex or marked watched on a Kino watchlist. By default everything is listed, without
   asking what's watched (so the page opens quickly); "seen=no" lists what you haven't seen, "seen=yes" what you have.
   With no search and no filters the library is shown by genre, one row each, like Plex's home page. The
   search is in the address, so Back from a movie returns to the same results. *@

<PageTitle>Library · Kolibri Kino</PageTitle>

<h1>@(Online ? "Search OMDb" : "Library")</h1>

<form class="searchbar" @onsubmit="SearchLibrary">
    <input type="search" @bind="_text" placeholder="Title…" aria-label="Title" disabled="@Busy" />
    <button type="submit" class="primary" disabled="@Busy">Search library</button>
    <button type="button" disabled="@(Busy || string.IsNullOrWhiteSpace(_text))" @onclick="SearchOmdb">Search OMDb</button>
</form>

@if (!Online)
{
    <div class="filters" role="group" aria-label="Filters">
        @* @key: the options arrive with the library, after the first render; a new select picks up the value. *@
        <select @key="@($"genre-{_genres.Count}")" aria-label="Genre" value="@(Genre ?? "")" @onchange="e => Go(genre: e.Value as string ?? string.Empty, page: 1)">
            <option value="">All genres</option>
            @foreach (var (genre, count) in _genres)
            {
                <option value="@genre">@genre (@count.ToString("N0"))</option>
            }
            @if (Genre is not null && !_genres.Any(g => string.Equals(g.Genre, Genre, StringComparison.OrdinalIgnoreCase)))
            {
                <option value="@Genre">@Genre (0)</option>
            }
        </select>
        <select @key="@($"year-{_hits.Count}")" aria-label="Year" value="@YearValue" @onchange="e => GoYears(e.Value as string)">
            @foreach (var (value, label) in YearChoices())
            {
                <option value="@value">@label</option>
            }
        </select>
        <select aria-label="IMDb rating" value="@(MinRating?.ToString(CultureInfo.InvariantCulture) ?? "")" @onchange="e => Go(rating: e.Value as string ?? string.Empty, page: 1)">
            <option value="">Any rating</option>
            @foreach (var r in RatingChoices)
            {
                <option value="@r.ToString(CultureInfo.InvariantCulture)">IMDb @r.ToString("0.#", CultureInfo.InvariantCulture)+</option>
            }
        </select>
        <select aria-label="Watched" value="@WatchedFilter.Value(SeenKey)" @onchange="e => Go(seen: e.Value as string ?? string.Empty, page: 1)">
            @foreach (var (value, label) in WatchedFilter.Choices)
            {
                <option value="@value">@label</option>
            }
        </select>
        <input type="search" placeholder="Actor or director…" aria-label="Actor or director"
               @bind="_person" @bind:after="() => Go(person: _person?.Trim() ?? string.Empty, page: 1)" />
        @if (!Filter.IsEmpty || SeenKey is not null)
        {
            <button type="button" class="quiet" @onclick="ClearFilters">Clear filters</button>
        }
    </div>
}

@if (ByCategory && CurrentPage == 1)
{
    <RecentShelf Seen="@SeenKey" Watched="_watched" />
}

<div class="toolbar">
    <div class="chips" role="group" aria-label="Type">
        @foreach (var (key, label, count) in _typeCounts)
        {
            <button class="chip @(key == SelectedType ? "on" : "")" @onclick="() => Go(type: UrlType(key), page: 1)">@label (@count.ToString("N0"))</button>
        }
    </div>
    @if (ByCategory && _shown.Count > 0)
    {
        <a class="sort" href="@Nav.GetUriWithQueryParameter("view", "all")">Browse all @_shown.Count.ToString("N0") ›</a>
    }
    else
    {
        <label class="sort">
            Sort
            <select value="@SortKey" @onchange="e => Go(sort: e.Value as string, page: 1)">
                <option value="listed">As listed</option>
                <option value="title">Title</option>
                <option value="year">Year (newest)</option>
                <option value="rating">Rating (best)</option>
                <option value="genre">Genre</option>
            </select>
        </label>
    }
</div>

<StatusLine Busy="Busy" Text="@(Status ?? Summary)" Error="@Error" />

@if (ByCategory)
{
    @foreach (var (genre, hits) in _shelves)
    {
        <section class="shelf" aria-label="@genre">
            <div class="shelf-head">
                <h2>@genre <span class="muted">@hits.Count.ToString("N0")</span></h2>
                <a href="@Nav.GetUriWithQueryParameters(new Dictionary<string, object?> { ["genre"] = genre, ["sort"] = "rating", ["page"] = null })">See all ›</a>
            </div>
            <div class="shelf-row">
                @foreach (var hit in hits.Take(ShelfSize))
                {
                    @Card(hit)
                }
            </div>
        </section>
    }
}
else
{
    <div class="cards">
        @foreach (var hit in PageOfHits)
        {
            @Card(hit)
        }
    </div>

    @if (PageCount > 1)
    {
        <nav class="pager" aria-label="Pages">
            <button disabled="@(CurrentPage <= 1)" @onclick="() => Go(page: CurrentPage - 1)">‹ Previous</button>
            <span>Page @CurrentPage of @PageCount</span>
            <button disabled="@(CurrentPage >= PageCount)" @onclick="() => Go(page: CurrentPage + 1)">Next ›</button>
        </nav>
    }
}

@code {
    private const int PageSize = 60;
    private const int ShelfSize = 20;
    private static readonly double[] RatingChoices = [9, 8.5, 8, 7.5, 7, 6, 5];

    [SupplyParameterFromQuery(Name = "q")] public string? Query { get; set; }
    [SupplyParameterFromQuery(Name = "online")] public bool Online { get; set; }
    [SupplyParameterFromQuery(Name = "type")] public string? Type { get; set; }
    [SupplyParameterFromQuery(Name = "sort")] public string? Sort { get; set; }
    [SupplyParameterFromQuery(Name = "page")] public int? Page { get; set; }
    [SupplyParameterFromQuery(Name = "genre")] public string? Genre { get; set; }
    [SupplyParameterFromQuery(Name = "from")] public int? YearFrom { get; set; }
    [SupplyParameterFromQuery(Name = "to")] public int? YearTo { get; set; }
    [SupplyParameterFromQuery(Name = "rating")] public double? MinRating { get; set; }
    [SupplyParameterFromQuery(Name = "person")] public string? Person { get; set; }
    [SupplyParameterFromQuery(Name = "view")] public string? View { get; set; }
    [SupplyParameterFromQuery(Name = "seen")] public string? Seen { get; set; }

    /// <summary>
    /// "no" (not watched, the default: no "seen" in the address), "yes" (watched), or null for all ("seen=all").
    /// OMDb results aren't in the library, so they aren't filtered.
    /// </summary>
    private string? SeenKey => Online ? null : WatchedFilter.Key(Seen);

    /// <summary>Watched on Plex or a watchlist; asked again when older than <see cref="WatchedMaxAge"/>.</summary>
    /// <remarks>Reloading Plex's whole movie list takes a while (seconds), so not on every click.</remarks>
    private static readonly TimeSpan WatchedMaxAge = TimeSpan.FromMinutes(30);
    private IReadOnlySet<string>? _watched;
    private DateTime _watchedAt;
    private string? _watchedNote;

    private string? _text;
    private string? _person;
    private IReadOnlyList<Hit> _hits = [];
    private List<Hit> _shown = [];
    private List<(string? Key, string Label, int Count)> _typeCounts = [];
    private IReadOnlyList<(string Genre, int Count)> _genres = [];
    private List<(string Genre, List<Hit> Hits)> _shelves = [];

    /// <summary>A library item (<see cref="Source"/>) or OMDb search result, as a card.</summary>
    private sealed record Hit(string ImdbId, string Title, string? Year, string? Type, string? Rating, string? Genre, string? PosterUrl, Item? Source = null);

    private LibraryFilter Filter => new(string.IsNullOrWhiteSpace(Genre) ? null : Genre.Trim(), YearFrom, YearTo, MinRating, Person);

    /// <summary>Nothing searched or filtered: the library by genre instead of one long list (until "Browse all").</summary>
    private bool ByCategory => !Online && string.IsNullOrWhiteSpace(Query) && Filter.IsEmpty && View != "all";

    private string SortKey => Sort ?? (Online ? "listed" : "title");
    private int PageCount => Math.Max(1, (_shown.Count + PageSize - 1) / PageSize);
    private int CurrentPage => Math.Clamp(Page ?? 1, 1, PageCount);
    private IEnumerable<Hit> PageOfHits => _shown.Skip((CurrentPage - 1) * PageSize).Take(PageSize);

    private string Summary
    {
        get
        {
            if (SeenKey is not null && _watched is null) return "Checking what you've watched…"; // no count until it's right
            var seen = WatchedFilter.Words(SeenKey);
            var note = SeenKey is not null && _watchedNote is not null ? $" ({_watchedNote}.)" : "";
            if (ByCategory) return $"{_shown.Count:N0}{seen} item(s) in library, in {_shelves.Count} genres.{note}";
            var counted = _shown.Count == _hits.Count ? $"{_hits.Count:N0}" : $"{_shown.Count:N0} of {_hits.Count:N0}";
            return Online ? $"{counted} result(s) from OMDb. Import adds one to the library." : $"{counted}{seen} item(s) in library.{note}";
        }
    }

    private RenderFragment Card(Hit hit) =>
        @<article class="card">
            <a href="@MovieDetails.DetailsUrl(hit.ImdbId, hit.Type)" class="card-link">
                <PosterImage Src="@hit.PosterUrl" />
                <div class="card-body">
                    <h2 class="card-title">@hit.Title</h2>
                    <div class="card-meta">
                        <span>@hit.Year</span>
                        @if (!string.IsNullOrWhiteSpace(hit.Type) && hit.Type != "movie")
                        {
                            <span class="tag">@hit.Type</span>
                        }
                        <Rating Value="@hit.Rating" />
                    </div>
                </div>
            </a>
            @if (Online)
            {
                <button class="card-action" disabled="@Busy" @onclick="() => ImportAsync(hit)">Import</button>
            }
            <CardStars ImdbId="@hit.ImdbId" Type="@hit.Type" Mine="_myRatings.GetValueOrDefault(hit.ImdbId)" />
        </article>;

    /// <summary>Your ratings (Kino's KinoRating), by IMDb id, for the stars on the cards.</summary>
    private IReadOnlyDictionary<string, MovieRating> _myRatings = new Dictionary<string, MovieRating>();

    protected override async Task OnParametersSetAsync()
    {
        (_text, _person) = (Query, Person);
        var key = $"{Online}|{Query?.Trim()}";
        if (LastSearch.Key != key)
        {
            await RunAsync(Online ? "Searching OMDb…" : "Loading library…", async ct =>
            {
                if (Online && !string.IsNullOrWhiteSpace(Query))
                    LastSearch.Remember(key, [], await Movies.SearchOnlineAsync(Query, ct));
                else
                    LastSearch.Remember(key, await Movies.SearchLocalAsync(Query ?? string.Empty, ct), []);
            });
        }

        // Your own ratings: a small collection, read each time so a rating set on a movie shows when you come back.
        try
        {
            _myRatings = (await Ratings.GetAllAsync()).ToDictionary(r => r.ImdbId, StringComparer.OrdinalIgnoreCase);
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            _myRatings = new Dictionary<string, MovieRating>(); // the cards just show no stars
        }

        // What's watched, only when the filter asks for it (it asks Plex), and again after a while (watched since).
        var syncWatchedList = false;
        if (SeenKey is not null && (_watched is null || DateTime.UtcNow - _watchedAt > WatchedMaxAge))
        {
            await RunAsync("Checking what you've watched…", async ct =>
            {
                (_watched, _watchedNote) = await Movies.GetWatchedAsync(refreshPlex: _watched is not null, ct);
                _watchedAt = DateTime.UtcNow;
                syncWatchedList = _watchedNote is null;
            });
        }

        _hits = LastSearch.Key != key ? [] // the search failed; the error is shown
            : Online
            ? LastSearch.Online.Select(s => new Hit(s.ImdbId, s.Title, s.Year, s.Type, null, null, OnlinePoster(s))).ToList()
            : LastSearch.Local.Select(i => new Hit(i.ImdbId, i.Title, i.Year, i.Type, i.ImdbRating, i.Genre, $"poster/{i.ImdbId}", i)).ToList();
        ApplyFilterAndSort();

        if (syncWatchedList) _ = UpdateWatchedListAsync();
    }

    /// <summary>
    /// In the background, after the list is shown: the watched marks are brought in step with Plex (movies stay on
    /// their lists; the Watched list shows every watched one). It doesn't change what the filter uses, so the filter
    /// doesn't wait for it; a failure is only noted below the filters.
    /// </summary>
    private async Task UpdateWatchedListAsync()
    {
        try
        {
            await Watchlists.UpdateWatchedAsync();
        }
        catch (Exception ex)
        {
            _watchedNote = $"the {WatchlistController.WatchedList} list couldn't be brought up to date: {ex.Message}";
            await InvokeAsync(StateHasChanged);
        }
    }

    private void ApplyFilterAndSort()
    {
        // The genre list comes from the title search alone, so another genre can be picked while one is chosen.
        _genres = LibraryFilter.Genres(_hits.Select(h => h.Source).OfType<Item>());
        var filter = Filter;
        var filtered = _hits
            .Where(h => h.Source is null || filter.Matches(h.Source))
            .Where(h => WatchedFilter.Matches(SeenKey, _watched, h.ImdbId))
            .ToList();

        _typeCounts = [(null, "All", filtered.Count)];
        _typeCounts.AddRange(filtered.GroupBy(h => TypeKey(h.Type)).OrderByDescending(g => g.Count()).Select(g => ((string?)g.Key, TypeLabel(g.Key), g.Count())));
        var type = SelectedType;

        var shown = filtered.Where(h => type is null || TypeKey(h.Type) == type);
        // Stable sorts on top of the title order, so each year, rating or genre is alphabetical, as in KinoForm.
        var byTitle = shown.OrderBy(h => h.Title, StringComparer.CurrentCultureIgnoreCase);
        _shown = SortKey switch
        {
            "title" => byTitle.ToList(),
            "year" => byTitle.OrderByDescending(h => h.Year, StringComparer.Ordinal).ToList(),
            "rating" => byTitle.OrderByDescending(h => WatchlistController.Rating(h.Rating)).ToList(),
            "genre" => byTitle.OrderBy(h => h.Genre ?? "￿", StringComparer.CurrentCultureIgnoreCase).ToList(),
            _ => shown.ToList(),
        };

        // One row per genre, biggest first, each best rated first; an item is in every genre it has.
        _shelves = !ByCategory ? [] : _shown
            .Where(h => h.Source is not null)
            .SelectMany(h => LibraryFilter.GenresOf(h.Source!).Select(g => (Genre: g, Hit: h)))
            .GroupBy(x => x.Genre, StringComparer.OrdinalIgnoreCase)
            .OrderByDescending(g => g.Count()).ThenBy(g => g.Key, StringComparer.CurrentCultureIgnoreCase)
            .Select(g => (g.First().Genre, g.Select(x => x.Hit).OrderByDescending(h => WatchlistController.Rating(h.Rating)).ToList()))
            .ToList();
    }

    private void SearchLibrary() => Go(q: _text?.Trim() ?? string.Empty, online: false, type: string.Empty, page: 1);

    private void SearchOmdb() => Go(q: _text?.Trim() ?? string.Empty, online: true, type: string.Empty, page: 1);

    private void ClearFilters() => Go(genre: string.Empty, from: string.Empty, to: string.Empty, rating: string.Empty, person: string.Empty, seen: string.Empty, page: 1);

    /// <summary>A year choice is "from-to", either side may be empty.</summary>
    private void GoYears(string? value)
    {
        var parts = (value ?? string.Empty).Split('-');
        Go(from: parts[0], to: parts.Length > 1 ? parts[1] : string.Empty, page: 1);
    }

    private string YearValue => YearFrom is null && YearTo is null ? "" : $"{YearFrom}-{YearTo}";

    /// <summary>Any year, this year, the last 5 and 10 years, then each decade back to the oldest in the library.</summary>
    private IEnumerable<(string Value, string Label)> YearChoices()
    {
        var now = DateTime.Today.Year;
        var choices = new List<(string, string)> { ("", "Any year"), ($"{now}-{now}", $"{now}"), ($"{now - 4}-", "Last 5 years"), ($"{now - 9}-", "Last 10 years") };
        var oldest = _hits.Select(h => h.Source).OfType<Item>().Select(LibraryFilter.YearOf).Min() ?? now;
        for (var decade = now / 10 * 10; decade >= oldest / 10 * 10; decade -= 10)
            choices.Add(($"{decade}-{decade + 9}", $"{decade}s"));
        if (YearValue is { Length: > 0 } current && choices.All(c => c.Item1 != current))
            choices.Add((current, $"{YearFrom}–{YearTo}"));
        return choices;
    }

    /// <summary>Changes the search in the address; <see cref="OnParametersSetAsync"/> does the rest. Null keeps a value, empty removes it.</summary>
    private void Go(string? q = null, bool? online = null, string? type = null, string? sort = null, int? page = null,
        string? genre = null, string? from = null, string? to = null, string? rating = null, string? person = null, string? seen = null)
    {
        static object? Keep(string? value, object? current) => value is null ? current : value.Length == 0 ? null : value;
        Nav.NavigateTo(Nav.GetUriWithQueryParameters(new Dictionary<string, object?>
        {
            ["q"] = Keep(q, Query),
            ["online"] = (online ?? Online) ? true : null,
            ["type"] = Keep(type, Type),
            ["sort"] = Keep(sort, Sort),
            ["page"] = (page ?? Page) is > 1 and var p ? p : null,
            ["genre"] = Keep(genre, Genre),
            ["from"] = Keep(from, YearFrom),
            ["to"] = Keep(to, YearTo),
            ["rating"] = Keep(rating, MinRating?.ToString(CultureInfo.InvariantCulture)),
            ["person"] = Keep(person, Person),
            ["seen"] = Keep(seen, Seen),
            ["view"] = q is null ? View : null, // a new title search leaves "Browse all"
        }));
    }

    private Task ImportAsync(Hit hit) => RunAsync($"Importing {hit.Title}…", async ct =>
    {
        var item = await Movies.ImportAsync(hit.ImdbId, ct);
        Status = item is null ? $"OMDb has no details for {hit.ImdbId}." : $"Saved {item.Title} ({item.Year}) in the library.";
    });

    /// <summary>The type filter from the address, or null for All (also when no result has that type).</summary>
    private string? SelectedType
    {
        get
        {
            var key = Type == "-" ? string.Empty : Type;
            return key is not null && _typeCounts.Any(t => t.Key == key) ? key : null;
        }
    }

    /// <summary>The type in the address: none for All, "-" for items without a type.</summary>
    private static string UrlType(string? key) => key is null ? string.Empty : key.Length == 0 ? "-" : key;

    private static string? OnlinePoster(SearchItem s) =>
        Uri.TryCreate(s.Poster, UriKind.Absolute, out var url) && url.Scheme is "http" or "https" ? s.Poster : null;

    /// <summary>OMDb writes "movie", SilverScreen's TMDb import wrote "Movie": compare lower-cased, and "" for none.</summary>
    private static string TypeKey(string? type) => (type ?? string.Empty).Trim().ToLowerInvariant();

    private static string TypeLabel(string key) => key switch
    {
        "" => "(no type)",
        "movie" => "Movies",
        "series" => "Series",
        "episode" => "Episodes",
        "game" => "Games",
        _ => char.ToUpperInvariant(key[0]) + key[1..],
    };
}
