@page "/settings"
@inherits KinoPage
@inject SettingsController Settings
@inject Kolibri.Kino.Controllers.Ratings.RatingController Ratings
@inject WebSync WebSync
@inject IStorageStatus Storage

@* Port of SettingsForm. The settings are the database's UserSettings document, shared with SilverScreen and the
   WinForms app; which user's document is Kino:SettingsUser (in a container, set it to your Windows user name). *@

<PageTitle>Settings · Kolibri Kino</PageTitle>

<h1>Settings</h1>

@if (_edited is { } s)
{
    <EditForm Model="s" OnSubmit="SaveAsync" class="settings">
        <fieldset>
            <legend>General</legend>
            <label>User <input value="@s.UserName" readonly /></label>
            <label>Library file <input value="@s.LiteDBFilePath" readonly /></label>
            <label>Favorite watchlist <InputText @bind-Value="s.FavoriteWatchList" /></label>
        </fieldset>

        <fieldset>
            <legend>Movie services</legend>
            <label>
                OMDb key <InputText @bind-Value="s.OMDBkey" />
                <small>Details, posters and search. <a href="https://www.omdbapi.com/apikey.aspx" target="_blank" rel="noopener">Get a free key</a>. Empty means the shared default.</small>
            </label>
            <label>
                TMDb key <InputText @bind-Value="s.TMDBkey" />
                <small>Episode details and TMDb links. <a href="https://www.themoviedb.org/settings/api" target="_blank" rel="noopener">Get a free key</a>. Empty means the shared default.</small>
            </label>
            <label>
                SubDL key <InputText @bind-Value="s.SUBDLkey" />
                <small>Subtitles. <a href="https://subdl.com" target="_blank" rel="noopener">Get a free key</a>.</small>
            </label>
            <label>
                Subtitle languages <InputText @bind-Value="s.SubtitleLanguages" />
                <small>Codes separated by commas, e.g. NO,EN. Empty means NO,EN.</small>
            </label>
        </fieldset>

        <fieldset>
            <legend>Plex</legend>
            <label>
                Plex server name <InputText @bind-Value="s.XPlexServerName" />
                <small>Host name or IP on your network. Kino connects to http://&lt;name&gt;:32400.</small>
            </label>
            <label>Plex token <InputText type="password" @bind-Value="s.XPlexToken" autocomplete="off" /></label>
        </fieldset>

        <fieldset>
            <legend>Uranus and KMDb</legend>
            <label>
                Uranus URL <InputText @bind-Value="s.UranusUrl" />
                <small>Kino's web service on problembar.net, e.g. https://problembar.net/uranus/apps/KolibriKino/.</small>
            </label>
            <label>
                Uranus token <InputText type="password" @bind-Value="s.UranusApiKey" autocomplete="off" />
                <small>The key in kino_config.php. KMDb uses the same key.</small>
            </label>
            <label>
                KMDb URL <InputText @bind-Value="s.KmdbUrl" placeholder="http://greenlantern:8086/" />
                <small>
                    Kolibri.Kino.KMDb: the library in MariaDB, shared by the web app and Kino on Windows. While it answers, it is
                    used; else the LiteDB file, which is kept up to date as the fallback. Empty: only the LiteDB file.
                    @if (_kmdbOverride)
                    {
                        <br /><text>This server uses its own address for KMDb (Kino:KmdbUrl), whatever is set here.</text>
                    }
                </small>
            </label>
        </fieldset>

        <fieldset>
            <legend>Library</legend>
            @{ var state = Storage.Current; }
            <p class="storage @(state.UsesKmdb ? "kmdb" : "litedb")">
                <strong>@(state.UsesKmdb ? "MariaDB (KMDb)" : "LiteDB file")</strong> · @state.Message
                @if (!state.UsesKmdb)
                {
                    <br /><text>MariaDB through KMDb is better when it is available: one library for the web app and Windows.</text>
                }
                @if (state.PendingChanges > 0)
                {
                    <br /><text>@state.PendingChanges change(s) made while KMDb didn't answer will be sent when it does.</text>
                }
            </p>
            <div class="actions"><button type="button" disabled="@Busy" @onclick="CheckStorageAsync">Check KMDb now</button></div>
        </fieldset>

        <fieldset>
            <legend>Folders</legend>
            <p class="hint">Shared with SilverScreen and Kino on Windows, so these are usually Windows paths.</p>
            <label>Movies <InputText @bind-Value="s.UserFilePaths.MoviesSourcePath" /></label>
            <label>Movies destination <InputText @bind-Value="s.UserFilePaths.MoviesDestinationPath" /></label>
            <label>Series <InputText @bind-Value="s.UserFilePaths.SeriesSourcePath" /></label>
            <label>Series destination <InputText @bind-Value="s.UserFilePaths.SeriesDestination" /></label>
            <label>Pictures <InputText @bind-Value="s.UserFilePaths.PicturesSourcePath" /></label>
            <label>Pictures destination <InputText @bind-Value="s.UserFilePaths.PicturesDestination" /></label>
        </fieldset>

        <div class="actions">
            <button type="submit" class="primary" disabled="@Busy">Save</button>
            <button type="button" disabled="@Busy" @onclick="TestAsync">Test connections</button>
            <button type="button" disabled="@Busy" @onclick="Reload">Undo changes</button>
        </div>
    </EditForm>

    @* Same frame as the boxes above (they're inside the form's .settings). *@
    <div class="settings">
        <fieldset>
            <legend>Export</legend>
            <p class="hint">
                @(_ratingCount switch { null => "", 0 => "No ratings yet.", 1 => "1 title rated.", var n => $"{n} titles rated." })
                With KMDb in use, the web app and the PC share one library. Without it the databases here and on the PC aren't
                kept in step: export your ratings to a file here, and import it on the PC (Settings → Importer vurderinger fra
                fil), or the other way. The newer rating of a title wins.
                The wishlist is exported as a CSV file for Excel, which the PC's Wishlist can import.
            </p>
            <div class="actions export-buttons">
                <a class="button" href="export/ratings" download>Export ratings</a>
                @* A label styled as a button opens the file picker; the input itself is hidden. *@
                <label class="button @(Busy ? "disabled" : "")">
                    Import ratings…
                    <InputFile OnChange="ImportRatingsAsync" accept=".json,application/json" disabled="@Busy" style="display: none" />
                </label>
                <a class="button" href="export/wishlist" download>Export wishlist</a>
            </div>
        </fieldset>
    </div>

    <p class="guide-link"><a href="guide">User guide</a>: how to use Kolibri Kino on the web.</p>

    @if (_checks.Count > 0)
    {
        <ul class="checks">
            @foreach (var check in _checks)
            {
                <li class="@(check.Ok ? "ok" : "bad")"><strong>@(check.Ok ? "✓" : "✗") @check.Service</strong> @check.Message</li>
            }
        </ul>
    }

    <StatusLine Busy="Busy" Text="@Status" Error="@Error" />
}

@code {
    private UserSettings? _edited;
    [Inject] private Microsoft.Extensions.Options.IOptions<Kolibri.Kino.Core.KinoOptions> KinoOptions { get; set; } = default!;
    private bool _kmdbOverride => !string.IsNullOrWhiteSpace(KinoOptions.Value.KmdbUrl);

    protected override void OnInitialized()
    {
        base.OnInitialized();
        Storage.Changed += OnStorageChanged;
    }

    private void OnStorageChanged(object? sender, EventArgs e) => InvokeAsync(StateHasChanged);

    private Task CheckStorageAsync() => RunAsync("Checking KMDb…", async ct =>
    {
        var state = await Storage.CheckAsync(ct);
        Status = state.UsesKmdb ? "The library is in MariaDB through KMDb." : "The library is in the LiteDB file: " + state.Message;
    });

    protected override void OnDispose() => Storage.Changed -= OnStorageChanged;
    private IReadOnlyList<ConnectionCheck> _checks = [];
    private int? _ratingCount;

    /// <summary>A ratings file is small (about 200 bytes a title); this is far above any real one.</summary>
    private const long MaxRatingsFile = 10 * 1024 * 1024;

    /// <summary>A file exported here or on the PC: the newer rating of a title wins, and changes are set on Plex too.</summary>
    private Task ImportRatingsAsync(InputFileChangeEventArgs e) => RunAsync("Importing ratings…", async ct =>
    {
        string json;
        using (var reader = new StreamReader(e.File.OpenReadStream(MaxRatingsFile, ct)))
            json = await reader.ReadToEndAsync(ct);

        var r = await Ratings.ImportAsync(json, ct);
        if (r.Added + r.Updated > 0) WebSync.Changed(WebSyncFile.Ratings);
        _ratingCount = (await Ratings.GetAllAsync(ct)).Count;
        Status = $"Ratings from {e.File.Name}: {r.Added} new, {r.Updated} updated, {r.KeptNewer} kept (newer here)"
                 + (r.Invalid > 0 ? $", {r.Invalid} invalid left out" : "") + "."
                 + (Ratings.PlexConfigured ? $" Plex: {r.SentToPlex} set." + (r.PlexNote is { } note ? $" {note}" : "") : "");
    });

    protected override async Task OnInitializedAsync()
    {
        Reload();
        _ratingCount = (await Ratings.GetAllAsync()).Count;
    }

    private void Reload()
    {
        _edited = Settings.GetEditableCopy();
        _checks = [];
        Status = Error = null;
    }

    private Task TestAsync() => RunAsync("Testing connections…", async ct => _checks = await Settings.TestAsync(_edited!, ct));

    private Task SaveAsync() => RunAsync("Saving…", async ct =>
    {
        await Settings.SaveAsync(_edited!, ct);
        _edited = Settings.GetEditableCopy();
        Status = "Settings saved. They apply at once.";
    });
}
