@page "/movie/{ImdbId}"
@page "/series/{ImdbId}"
@using Kolibri.Kino.Controllers.Library
@using Kolibri.Kino.Controllers.Playback
@using Kolibri.Kino.Controllers.Series
@using Kolibri.Kino.Controllers.Wishlist
@inherits KinoPage
@inject MovieController Movies
@inject LastSearch LastSearch
@inject PlaybackController Playback
@inject WatchlistController Watchlists
@inject LocalSeriesController LocalSeries
@inject WishlistController Wishlist
@inject Kolibri.Kino.Controllers.Ratings.RatingController Ratings
@inject LibraryFiles LibraryFiles
@inject NavigationManager Nav

@* Port of MovieDetailsForm plus KinoForm's right-click menu: details, import/update from OMDb, links, Mark as
   watched (onto the Watched watchlist, and on Plex) and Add to watchlist (a Kino watchlist and/or a Plex playlist,
   as the Windows app's dialog). Removing from watchlists is left to the Windows app. Note: deploying the library to the NAS again (-WithDatabases) replaces the NAS copy, watched marks included.
   A series lives at /series/{id} (a /movie/ link is turned into that) and lists its episodes by season, each
   with Play (the own file) and Plex. *@

<PageTitle>@(_item?.Title ?? ImdbId) · Kolibri Kino</PageTitle>

<p class="back"><a href="javascript:history.back()">‹ Back</a></p>

@if (_item is null)
{
    <StatusLine Busy="Busy" Text="@(Status ?? (Busy ? null : $"No details found for {ImdbId}."))" Error="@Error" />
}
else
{
    <div class="details">
        <PosterImage Src="@($"poster/{ImdbId}")" Class="large" />

        <div class="details-text">
            <h1>@_item.Title</h1>
            <p class="facts">
                <span>
                    @for (var i = 0; i < FactParts.Count; i++)
                    {
                        @(i > 0 ? " · " : "")
                        @if (FactParts[i] == GenreFact)
                        {
                            var genres = LibraryFilter.GenresOf(_item).ToList();
                            @for (var g = 0; g < genres.Count; g++)
                            {
                                @(g > 0 ? ", " : "")<a href="@LibraryLink("genre", genres[g])" title="More @genres[g] in the library">@genres[g]</a>
                            }
                        }
                        else
                        {
                            @FactParts[i]
                        }
                    }
                </span>
                <Rating Value="@_item.ImdbRating" />
            </p>
            <p class="where">
                @if (_completeness is { } complete)
                {
                    <span class="tag @CompletenessClass(complete.State)" title="@complete.Explanation">@complete.Label</span>
                }
                @if (_inLibrary)
                {
                    <span class="tag good">In library</span>
                }
                else
                {
                    <span class="tag">Not in library (from OMDb)</span>
                }
                @if (_watched)
                {
                    <span class="tag good">Watched</span>
                }
                @if (_linkedPath is not null)
                {
                    <span class="path" title="Linked file or folder">@_linkedPath</span>
                }
            </p>
            @if (_completeness is { Missing.Count: > 0 } incomplete)
            {
                <p class="missing-episodes">
                    <a href="@($"series/{ImdbId}#episodes")">Missing (@incomplete.Source knows them): @LocalSeriesController.Describe(incomplete.Missing)</a>
                    @{ var notWished = incomplete.Missing.Where(e => !_wishedEpisodes.Contains((e.SeasonNumber, e.EpisodeNumber))).ToList(); }
                    @if (notWished.Count > 1)
                    {
                        <button class="small" disabled="@Busy" @onclick="() => WishEpisodesAsync(notWished)">+ All @notWished.Count to wishlist</button>
                    }
                </p>
            }

            <p class="actions">
                @if (!IsSeries && (_canPlay || _plexPage is not null))
                {
                    <a class="button primary play" href="play/@ImdbId">▶ Play</a>
                }
                <button class="play" disabled="@Busy" @onclick="() => _addingToList = true">+ Add to watchlist</button>
                @* Without a file (not in the library, or in it without one): to get. *@
                @if (!_hasFile)
                {
                    @if (_onWishlist)
                    {
                        <a class="button play" href="wishlist" title="It's on the wishlist">On wishlist ›</a>
                    }
                    else
                    {
                        <button class="play" disabled="@Busy" title="Put it on the wishlist, the titles you want to get" @onclick="AddToWishlistAsync">+ Add to wishlist</button>
                    }
                }
            </p>

            @if (_addingToList)
            {
                <AddToWatchlistDialog ImdbId="@ImdbId" Title="@_item.Title" OnClose="ListDialogClosed" />
            }

            @if (Clean(_item.Plot) is { } plot)
            {
                <p class="plot">@plot</p>
            }

            <dl class="facts-list">
                @foreach (var (label, value) in People)
                {
                    <dt>@label</dt>
                    @if (label is "Director" or "Actors")
                    {
                        var names = value.Split(',', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries);
                        <dd>
                            @for (var n = 0; n < names.Length; n++)
                            {
                                @(n > 0 ? ", " : "")<a href="@LibraryLink("person", names[n])" title="@names[n] in the library">@names[n]</a>
                            }
                        </dd>
                    }
                    else
                    {
                        <dd>@value</dd>
                    }
                }
                @if (_item.Ratings is { Count: > 0 } ratings)
                {
                    <dt>Ratings</dt>
                    <dd>@string.Join(" · ", ratings.Select(r => $"{r.Source} {r.Value}"))</dd>
                }
            </dl>

            <div class="actions">
                @if (_inLibrary)
                {
                    <button disabled="@Busy" @onclick="ImportAsync">Update from OMDb</button>
                }
                else
                {
                    <button class="primary" disabled="@Busy" @onclick="ImportAsync">Import to library</button>
                }
                @if (!_watched)
                {
                    <button disabled="@Busy" @onclick="MarkWatchedAsync">Mark as watched</button>
                }
                @if (!_hasRating && !_ratingOpen)
                {
                    <button disabled="@Busy" title="Rate it with stars, as on Plex" @onclick="() => _ratingOpen = true">★ My rating</button>
                }
            </div>

            @* Shown once you've rated it; until then, the My rating button opens it. *@
            @if (_hasRating || _ratingOpen)
            {
                <div id="my-rating" tabindex="-1" @ref="_ratingAnchor">
                    <MyRating ImdbId="@ImdbId" Title="@_item.Title" />
                </div>
            }


            <p class="links">
                <a href="https://www.imdb.com/title/@ImdbId/" target="_blank" rel="noopener">IMDb</a>
                @if (_tmdbPage is not null)
                {
                    <a href="@_tmdbPage" target="_blank" rel="noopener">TMDb</a>
                }
                @if (_plexPage is not null)
                {
                    <a href="@_plexPage" target="_blank" rel="noopener">Plex</a>
                }
            </p>

            <StatusLine Busy="Busy" Text="@Status" Error="@Error" />
        </div>
    </div>

    @if (_similar.Count > 0)
    {
        <section class="similar">
            <h2>Similar movies</h2>
            <p class="hint">TMDb's suggestions. One you'd like to see or get: <b>+ Wishlist</b> searches for it there.</p>
            <div class="similar-row">
                @foreach (var s in _similar)
                {
                    <div class="similar-card">
                        <a href="movie/@s.Movie.ImdbId" title="@s.Movie.Title">
                            @if (s.Movie.Poster is { } poster)
                            {
                                <img src="@poster" alt="" loading="lazy" />
                            }
                            else
                            {
                                <span class="poster placeholder"></span>
                            }
                            <span class="similar-title">@s.Movie.Title</span>
                        </a>
                        <span class="muted small" title="Year (IMDb rating)">@s.YearAndRating</span>
                        @if (s.HasFile)
                        {
                            <span class="tag good">In SilverScreen</span>
                        }
                        else if (s.InLibrary)
                        {
                            <span class="tag nofile" title="In the library, but not linked to a file that's there">In SilverScreen, no file</span>
                        }
                        <a class="button small" href="@($"wishlist?q={Uri.EscapeDataString(s.WishlistQuery)}")">+ Wishlist</a>
                    </div>
                }
            </div>
        </section>
    }
    <div>
    </div>

    @if (IsSeries && _episodes.Count > 0)
    {
        var missingCount = _completeness?.Missing.Count ?? 0;
        <section class="episodes-section" id="episodes">
            <h2>Episodes <span class="muted">@_episodes.Count@(missingCount > 0 ? $" · {missingCount} missing" : "")</span></h2>
            @* Newest season first (like Plex's season list read from the top); "Other files" last. Missing episodes
               (the episode list has them, the folder doesn't) in their place, with + Wishlist. *@
    @foreach (var season in EpisodeRows().GroupBy(r => r.Season).OrderByDescending(g => g.Key == 0 ? -1 : g.Key))
            {
                var missingHere = season.Count(r => r.Missing is not null);
                <section class="season">
                    <h3 class="period-title">@(season.Key == 0 ? "Other files" : $"Season {season.Key}")
                        <span class="muted">@season.Count(r => r.File is not null)@(missingHere > 0 ? $" · {missingHere} missing" : "")</span></h3>
                    <ol class="episodes">
                        @foreach (var row in season)
                        {
                            @if (row.Missing is { } gone)
                            {
                                <li class="missing">
                                    <div class="episode-row">
                                        <span class="ep-label">S@(gone.SeasonNumber.ToString("00"))E@(gone.EpisodeNumber.ToString("00"))</span>
                                        <span class="path">@gone.Title@(gone.AirDate is { } aired ? $" · {aired:yyyy-MM-dd}" : "")</span>
                                        <span class="episode-actions">
                                            <span class="tag bad" title="@(_completeness?.Source)'s episode list has it; the series folder doesn't">Missing</span>
                                            @if (_wishedEpisodes.Contains((gone.SeasonNumber, gone.EpisodeNumber)))
                                            {
                                                <a class="button" href="wishlist" title="It's on the wishlist">On wishlist</a>
                                            }
                                            else
                                            {
                                                <button disabled="@Busy" title="Put this episode on the wishlist" @onclick="() => WishEpisodesAsync([gone])">+ Add to wishlist</button>
                                            }
                                        </span>
                                    </div>
                                </li>
                                continue;
                            }
                            var episode = row.File!;
                            <li>
                                <div class="episode-row">
                                    <span class="ep-label">@episode.Label</span>
                                    <span class="path">@episode.FileName</span>
                                    <span class="episode-actions">
                                        <a class="button primary" href="play/@ImdbId?ep=@Uri.EscapeDataString(episode.Key)">▶ Play</a>
                                        @if (PlaybackController.PlexPageOf(episode, _plexEpisodes) is { } plexPage)
                                        {
                                            <a class="button" href="@plexPage" target="_blank" rel="noopener">Plex</a>
                                        }
                                    </span>
                                </div>
                            </li>
                        }
                    </ol>
                </section>
            }
        </section>
    }
}

@code {
    [Parameter] public string ImdbId { get; set; } = string.Empty;

    private Item? _item;
    private bool _inLibrary;
    private bool _watched;
    private bool _hasRating;
    private bool _ratingOpen;

    /// <summary>Opened from a card's stars (…#my-rating): scrolled there once the panel is shown.</summary>
    private bool _scrollToRating;
    private ElementReference _ratingAnchor;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_scrollToRating || !_hasRating) return;
        _scrollToRating = false;
        await _ratingAnchor.FocusAsync(preventScroll: false); // focusing scrolls it into view
    }
    private string? _linkedPath;
    private string? _tmdbPage;
    private bool _canPlay;

    /// <summary>In the library and linked to a file (a series: its folder) that's there.</summary>
    private bool _hasFile;
    private bool _onWishlist;

    private Task AddToWishlistAsync() => RunAsync("Adding to the wishlist…", async ct =>
    {
        var added = await Wishlist.AddAsync(ImdbId, ct);
        _onWishlist = true;
        Status = $"Put {added.Title} on the wishlist.";
    });
    private string? _plexPage;
    private IReadOnlyList<PlayableEpisode> _episodes = [];
    private IReadOnlyDictionary<(int Season, int Episode), string> _plexEpisodes = new Dictionary<(int, int), string>();
    private bool _addingToList;
    private IReadOnlyList<SimilarMovie> _similar = [];
    private SeriesCompleteness? _completeness;

    /// <summary>An Episodes row: a file in the series folder, or an episode the list has and the folder doesn't.</summary>
    private sealed record EpisodeRow(int Season, int Number, PlayableEpisode? File, SeriesEpisode? Missing);

    /// <summary>The files, with the missing episodes (from the completeness check) put in their place by number.</summary>
    private IEnumerable<EpisodeRow> EpisodeRows() =>
        _episodes.Select((e, i) => new EpisodeRow(e.Season, e.Episodes.Count > 0 ? e.Episodes[0] : int.MaxValue - _episodes.Count + i, e, null))
            .Concat((_completeness?.Missing ?? []).Select(m => new EpisodeRow(m.SeasonNumber, m.EpisodeNumber, null, m)))
            .OrderBy(r => r.Season).ThenBy(r => r.Number);
    private IReadOnlySet<(int Season, int Episode)> _wishedEpisodes = new HashSet<(int, int)>();

    private Task WishEpisodesAsync(IReadOnlyList<SeriesEpisode> episodes) => RunAsync("Adding to the wishlist…", async ct =>
    {
        var added = await Wishlist.AddEpisodesAsync(ImdbId, episodes, ct);
        _wishedEpisodes = await Wishlist.GetEpisodesAsync(ImdbId, ct);
        Status = added == 1 ? $"Put {LocalSeriesController.Describe(episodes)} on the wishlist."
            : $"Put {added} episodes on the wishlist ({LocalSeriesController.Describe(episodes)}).";
    });

    /// <summary>Green complete, yellow up to date (more coming), orange behind or unknown, red ended with episodes missing.</summary>
    private static string CompletenessClass(CompletenessState state) => state switch
    {
        CompletenessState.Complete => "good",
        CompletenessState.UpToDate => "coming",
        CompletenessState.Incomplete => "bad",
        _ => "medium",
    };

    /// <summary>The series' completeness, from the episodes found in its folder; failures leave it out.</summary>
    private async Task LoadCompletenessAsync()
    {
        try
        {
            var onDisk = _episodes.Where(e => e.Season > 0).SelectMany(e => e.Episodes.Select(n => (e.Season, n))).ToList();
            _completeness = await LocalSeries.GetCompletenessAsync(ImdbId, onDisk);
            // Wished-for episodes that have arrived come off the wishlist.
            var arrived = await Wishlist.RemoveEpisodesOnDiskAsync(ImdbId, onDisk);
            if (arrived.Count > 0) Status = $"Here now, so taken off the wishlist: {string.Join(", ", arrived)}.";
            _wishedEpisodes = await Wishlist.GetEpisodesAsync(ImdbId);
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            _completeness = null;
        }
    }

    /// <summary>The dialog closed: its sentence (null when cancelled) goes in the status line.</summary>
    private void ListDialogClosed(string? message)
    {
        _addingToList = false;
        if (message is not null) (Status, Error) = (message, null);
    }

    protected override async Task OnParametersSetAsync()
    {
        (_item, _inLibrary, _linkedPath, _tmdbPage, _canPlay, _plexPage, _watched) = (null, false, null, null, false, null, false);
        (_completeness, _wishedEpisodes) = (null, new HashSet<(int, int)>());
        (_episodes, _plexEpisodes, _similar) = ([], new Dictionary<(int, int), string>(), []);
        await RunAsync("Loading…", async ct =>
        {
            var local = await Movies.GetFromLibraryAsync(ImdbId, ct);
            _inLibrary = local is not null;
            _item = local ?? await Movies.GetDetailsAsync(ImdbId, ct);
            _linkedPath = _inLibrary ? await Movies.GetLinkedPathAsync(ImdbId, ct) : null;
            _hasFile = _inLibrary && (await LibraryFiles.WithFileAsync([ImdbId], ct)).Count > 0;
            _onWishlist = !_hasFile && await Wishlist.IsOnWishlistAsync(ImdbId, ct);
            _watched = await Watchlists.IsWatchedAsync(ImdbId, ct);
            (_hasRating, _ratingOpen) = (await Ratings.GetAsync(ImdbId, ct) is not null, false);
            _scrollToRating = Nav.Uri.EndsWith("#my-rating", StringComparison.OrdinalIgnoreCase);
        });

        // TMDb pages use TMDb's own ids: one TMDb request, after the page is shown. A search link if TMDb doesn't know it.
        if (_item is { } item)
        {
            // A series has its own address; Back still works, as the /movie/ entry is replaced. The same page stays
            // (same id, so Blazor doesn't set the parameters again), so loading carries on below.
            if (IsSeries && Nav.ToBaseRelativePath(Nav.Uri).StartsWith("movie/", StringComparison.OrdinalIgnoreCase))
                Nav.NavigateTo($"series/{ImdbId}", replace: true);

            // Play shows at once for the own file or a series' episodes; TMDb and Plex follow (Plex loads its lists once, then keeps them).
            if (IsSeries) _episodes = _inLibrary ? await Playback.GetEpisodesAsync(ImdbId) : [];
            else _canPlay = _inLibrary && await Playback.HasLocalVideoAsync(ImdbId);
            StateHasChanged();
            // Only with episodes found: without the folder everything would look missing.
            if (IsSeries && _episodes.Any(e => e.Season > 0))
            {
                await LoadCompletenessAsync();
                StateHasChanged();
            }
            _tmdbPage = await Movies.GetTmdbPageAsync(ImdbId, item.Title);
            StateHasChanged();
            _plexPage = await Playback.GetPlexPageAsync(ImdbId);
            StateHasChanged();
            if (!IsSeries) _similar = await Movies.GetSimilarAsync(ImdbId);
            if (IsSeries && _episodes.Count > 0) _plexEpisodes = await Playback.GetPlexEpisodePagesAsync(ImdbId);
            StateHasChanged();
        }
    }

    private bool IsSeries => string.Equals(_item?.Type, "series", StringComparison.OrdinalIgnoreCase);

    /// <summary>The details address for an item: /series/ for a series, else /movie/.</summary>
    public static string DetailsUrl(string imdbId, string? type) =>
        string.Equals(type, "series", StringComparison.OrdinalIgnoreCase) ? $"series/{imdbId}" : $"movie/{imdbId}";

    private Task ImportAsync() => RunAsync(_inLibrary ? "Updating from OMDb…" : "Importing…", async ct =>
    {
        var item = await Movies.ImportAsync(ImdbId, ct);
        if (item is null)
        {
            Status = $"OMDb has no details for {ImdbId}.";
            return;
        }
        Status = _inLibrary ? "Updated from OMDb." : $"Saved {item.Title} ({item.Year}) in the library.";
        (_item, _inLibrary) = (item, true);
        LastSearch.Forget();
    });

    /// <summary>Onto the Watched watchlist (moved from another list if it's on one), and watched on Plex when Plex has it.</summary>
    private Task MarkWatchedAsync() => RunAsync("Marking as watched…", async ct =>
    {
        Status = await Watchlists.MarkWatchedAsync(ImdbId, ct);
        _watched = true;
    });

    /// <summary>Stands for the genres in <see cref="FactParts"/>, which are shown as links.</summary>
    private const string GenreFact = "genre";

    private List<string> FactParts => new[]
    {
        _item!.Year, _item.Runtime, LibraryFilter.GenresOf(_item).Any() ? GenreFact : null, _item.Rated,
        _item.Type is "series" && Clean(_item.TotalSeasons) is { } seasons ? $"{seasons} season(s)" : null,
    }.Select(Clean).OfType<string>().ToList();

    /// <summary>The Library filtered by a genre or person, best rated first.</summary>
    private static string LibraryLink(string filter, string value) => $"./?{filter}={Uri.EscapeDataString(value)}&sort=rating";

    private IEnumerable<(string, string)> People => new (string Label, string? Value)[]
    {
        ("Director", _item!.Director), ("Writer", _item.Writer), ("Actors", _item.Actors), ("Released", _item.Released),
        ("Language", _item.Language), ("Country", _item.Country), ("Awards", _item.Awards), ("Box office", _item.BoxOffice),
    }.Where(p => Clean(p.Value) is not null).Select(p => (p.Label, p.Value!));

    /// <summary>OMDb writes "N/A" for missing values.</summary>
    private static string? Clean(string? value) => string.IsNullOrWhiteSpace(value) || value == "N/A" ? null : value;
}
