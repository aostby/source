# Copy to .env next to compose.yaml on the NAS and fill in.

# The NAS user and group that own the data folder. Over SSH on the NAS, "id" prints them (uid=… gid=…).
PUID=1000
PGID=10

# Your Windows user name: the settings document SilverScreen and Kino for Windows saved.
KINO_SETTINGS_USER=

# Port on the NAS: the app is at http://<nas-name>.local:8085 (e.g. http://greenlantern.local:8085) or http://<nas-ip>:8085
KINO_PORT=8085

TZ=Europe/Oslo

# The Plex server's name and IP address. Posters in the library point at it by name, which the container
# can't look up. On the PC, "ping -4 HTPC" shows the address; give it a fixed IP in the router.
PLEX_HOST_NAME=HTPC
PLEX_HOST_IP=

# The Plex server's name as browsers on the network (phones too) find it, for the "Plex" links. Windows names
# like HTPC only work between PCs; htpc.local works on phones. Empty sends the links with PLEX_HOST_NAME.
PLEX_BROWSER_HOST=htpc.local

# Where the media shares are on the NAS (mounted read-only for Recently added). Over SSH: ls -d /volume*/Movies
MOVIES_DIR=/volume2/Movies
MULTIMEDIA_DIR=/volume3/Multimedia
SERIES_DIR=/volume3/Series
