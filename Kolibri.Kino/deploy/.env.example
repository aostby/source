# Copy to .env next to compose.yaml on the NAS and fill in.

# The NAS user and group that own the data folder. Over SSH on the NAS, "id" prints them (uid=… gid=…).
PUID=1000
PGID=10

# Your Windows user name: the settings document SilverScreen and Kino for Windows saved.
KINO_SETTINGS_USER=

# Port on the NAS: the app is at http://<nas-name>.local:8085 (e.g. http://greenlantern.local:8085) or http://<nas-ip>:8085
KINO_PORT=8085

TZ=Europe/Oslo

# The Plex server's name and IP address. Posters in the library point at it by name, which the container
# can't look up. On the PC, "ping -4 HTPC" shows the address; give it a fixed IP in the router.
PLEX_HOST_NAME=HTPC
PLEX_HOST_IP=

# The Plex server's name as browsers on the network (phones too) find it, for the "Plex" links. Windows names
# like HTPC only work between PCs; htpc.local works on phones. Empty sends the links with PLEX_HOST_NAME.
PLEX_BROWSER_HOST=htpc.local

# The key in kino_config.php on problembar.net (uranus/apps/KolibriKino): the wishlist and your ratings are sent
# there after each change. Empty turns it off.
KINO_WEB_API_KEY=

# Where the media shares are on the NAS (mounted read-only for Recently added). Over SSH: ls -d /volume*/Movies
MOVIES_DIR=/volume2/Movies
MULTIMEDIA_DIR=/volume3/Multimedia
SERIES_DIR=/volume3/Series

# Kolibri.Kino.KMDb (OMDb's API on the IMDb database): port on the NAS, the key clients send (the same key as
# KINO_WEB_API_KEY, from kino_config.php) and the database (DefaultConnection in Kino's settings). Keep the connection
# string in single quotes, so a $ in the password is not read as a variable.
KMDB_PORT=8086
KMDB_API_KEY=
IMDB_CONNECTION=
# Optional: the Plex token (XPlexToken in Kino's settings), so KMDb can serve posters only Plex has. Stays in the service.
KMDB_PLEX_TOKEN=

# Monitoring (optional): Prometheus + Grafana for KMDb's metrics. "monitoring" starts them with the rest; leave it
# empty if you have Grafana elsewhere (it can scrape http://<nas>:8086/metrics and import
# monitoring/grafana/dashboards/kmdb.json). Change the Grafana password before starting it the first time.
COMPOSE_PROFILES=
GRAFANA_PORT=3000
GRAFANA_ADMIN_PASSWORD=
PROMETHEUS_PORT=9090
PROMETHEUS_RETENTION=30d

# Grafana alerts by e-mail (KMDb unreachable, IMDb database down, SilverScreen library down, Plex posters not loaded).
# GRAFANA_SMTP_HOST is host:port, e.g. smtp.gmail.com:587 (Gmail needs an app password as GRAFANA_SMTP_PASSWORD).
GRAFANA_SMTP_ENABLED=false
GRAFANA_SMTP_HOST=
GRAFANA_SMTP_USER=
GRAFANA_SMTP_PASSWORD=
GRAFANA_SMTP_FROM=
GRAFANA_ALERT_EMAIL=
